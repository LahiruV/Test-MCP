# Base URL of the authentication API.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put secrets (API keys, client secrets, tokens) in this file or any
# VITE_ variable - everything here ships to the client in plain text.
VITE_API_BASE_URL=http://localhost:8080/api

# Set to "true" to serve the API from the MSW mock backend in development.
# Sign in with user@example.com / password123. See src/mocks/handlers.ts for
# the addresses that trigger the locked, throttled and server-error paths.
VITE_ENABLE_API_MOCKS=false
